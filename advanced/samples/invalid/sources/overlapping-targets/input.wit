package test:overlapping-sources@1.0.0;
world system { export example; }
interface example {
  record request {
    /// @nexus.source targets="workflow" python="first()" typescript="first()" go="First(ctx)" dotnet="First()"
    /// @nexus.source targets="workflow,client" python="second()" typescript="second()" go="Second(ctx)" dotnet="Second()"
    context: string,
  }
  submit: func(request: request);
}

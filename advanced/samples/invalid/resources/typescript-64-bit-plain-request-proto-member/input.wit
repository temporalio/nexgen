package temporal:counters@1.0.0;

world system { export counter-service; }

/// @nexus.endpoint "__counter_service"
interface counter-service {
  /// @nexus.proto "google.protobuf.Timestamp"
  record timestamp {
    seconds: option<s64>,
    nanos: option<s32>,
  }

  resource counter {
    constructor(counter-id: string);

    touch: func(seconds: option<s64>);
  }

  record touch-request {
    counter-id: string,
    at: option<timestamp>,
  }

  touch: func(request: touch-request);
}

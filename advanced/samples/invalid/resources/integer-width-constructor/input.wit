package test:integer-width@1.0.0;
world system { export clocks; }
interface clocks {
  /// @nexus.proto "google.protobuf.Timestamp"
  record timestamp {
    seconds: option<s64>,
    nanos: option<s32>,
  }
  resource clock {
    constructor(seconds: option<s32>, nanos: option<s32>);
    touch: func();
  }
  touch: func(request: timestamp);
}

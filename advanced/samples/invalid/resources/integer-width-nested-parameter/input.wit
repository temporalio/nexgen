package test:integer-width@1.0.0;
world system { export clocks; }
interface clocks {
  /// @nexus.proto "google.protobuf.Timestamp"
  record timestamp {
    seconds: option<s64>,
    nanos: option<s32>,
  }
  /// @nexus.proto "temporal.api.namespace.v1.BadBinaryInfo"
  record nested-request {
    create-time: timestamp,
    reason: option<string>,
    operator: option<string>,
  }
  resource clock {
    constructor();
    touch: func(seconds: option<s64>, nanos: option<s64>);
  }
  touch: func(request: nested-request);
}

package temporal:counters@1.0.0;

world system { export counter-service; }

/// @nexus.endpoint "__counter_service"
interface counter-service {
  resource counter {
    constructor(counter-id: string, total: s64);

    add: func();
  }

  record add-request {
    counter-id: string,
    total: s64,
  }

  add: func(request: add-request);
}

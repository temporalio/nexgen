package test:integers@1.0.0;

world system { export counters; }

interface counters {
  /// @nexus.proto "google.protobuf.Timestamp"
  record timestamp {
    seconds: option<s64>,
    nanos: option<s32>,
  }

  resource counter {
    constructor(seconds: option<s64>, nanos: option<s32>);
    touch: func();
  }

  type counter-result = own<counter>;
  record get-counter-request {}
  get-counter: func(request: get-counter-request) -> counter-result;
  touch: func(request: timestamp);
}

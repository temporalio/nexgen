package test:mixed-resource@1.0.0;
world system { export clocks; }
interface clocks {
  /// @nexus.proto "google.protobuf.Timestamp"
  record timestamp {
    seconds: option<s64>,
    nanos: option<s32>,
  }
  resource clock {
    constructor(name: string, at: option<timestamp>);
  }
  type clock-result = own<clock>;
  record get-clock-request {}
  get-clock: func(request: get-clock-request) -> clock-result;
}

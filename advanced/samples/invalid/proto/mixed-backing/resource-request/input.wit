package test:integers@1.0.0;

world system { export counters; }

interface counters {
  /// @nexus.proto "google.protobuf.Timestamp"
  record timestamp {
    seconds: option<s64>,
    nanos: option<s32>,
  }

  resource counter {
    constructor(seconds: option<s64>, nanos: option<s32>);
    proto-touch: func();
    json-touch: func();
  }

  record json-request {
    seconds: option<s64>,
    nanos: option<s32>,
  }

  proto-touch: func(request: timestamp);
  json-touch: func(request: json-request);
}

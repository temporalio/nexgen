package test:unknown-enum-default;

world system { export models; }

interface models {
  type placeholder = string;

  /// @nexus.proto "temporal.api.enums.v1.Severity"
  type alert-level = placeholder;

  /// @nexus.proto "temporal.api.version.v1.Alert"
  record alert {
    message: string,
    /// @nexus.default "missing-case"
    severity: alert-level,
  }
}

package test:proto-field-helper-without-pair@1.0.0;

world system { export stream-service; }

/// @nexus.endpoint "streams"
interface stream-service {
  /// @nexus.proto "acme.streams.v1.StreamRef"
  record stream-ref {
    id: string,
  }

  /// @nexus.proto "acme.streams.v1.Request"
  record request {
    // The helper that reads the message has no helper that writes it.
    /// @nexus.proto-field "stream_id" python-from="stream_ref_from_id"
    ref: stream-ref,
  }
}

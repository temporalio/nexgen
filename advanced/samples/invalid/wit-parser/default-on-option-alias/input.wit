package example:defaults@1.0.0;

world system { export defaults-service; }

interface defaults-service {
  type maybe-count = option<u32>;
  type count-alias = maybe-count;
  record request {
    /// @nexus.default python="3" typescript="3" go="3" dotnet="3u"
    attempts: count-alias,
  }
  submit: func(request: request);
}

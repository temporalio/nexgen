package temporal:poll-function-input@1.0.0;

world service { export reader; }

interface functions {
  type placeholder = string;

  read-call: func(name: string) -> string;

  /// @nexus.function
  ///   primary=true
  ///   signature="read-call"
  type read-function = placeholder;
}

/// @nexus.endpoint "reader"
interface reader {
  use functions.{read-function};

  record read-request { function: read-function, offset: option<s64> }
  record read-response { done: option<bool> }

  /// @nexus.poll python="next_read" target="client"
  read: func(request: read-request) -> read-response;
}

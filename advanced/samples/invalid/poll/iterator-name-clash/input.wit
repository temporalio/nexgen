package temporal:poll-iterator-name-clash@1.0.0;

world service { export reader; }

// The iterator of `read` would be `iter_read`, the name of another operation.
/// @nexus.endpoint "reader"
interface reader {
  record read-request { offset: option<s64> }
  record read-response { done: option<bool> }

  /// @nexus.poll python="next_read" targets="client"
  read: func(request: read-request) -> read-response;
  iter-read: func(request: read-request) -> read-response;
}

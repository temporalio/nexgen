package temporal:poll-resource-iterator-name-clash@1.0.0;

world service { export reader; }

// The iterator of the `read` method would be `iter_read`, the name of another method.
/// @nexus.endpoint "reader"
interface reader {
  resource feed {
    constructor(feed-id: string);

    read: func(offset: option<s64>);
    iter-read: func(offset: option<s64>);
  }

  record read-request { feed-id: string, offset: option<s64> }
  record read-response { done: option<bool> }

  /// @nexus.poll python="next_read" target="client"
  read: func(request: read-request) -> read-response;
}

package temporal:poll-on-resource-method@1.0.0;

world service { export reader; }

/// @nexus.endpoint "reader"
interface reader {
  resource feed {
    constructor(feed-id: string);

    /// @nexus.poll python="next_read" targets="client"
    read: func(offset: option<s64>);
  }

  record read-request { feed-id: string, offset: option<s64> }
  record read-response { done: option<bool> }

  read: func(request: read-request) -> read-response;
}

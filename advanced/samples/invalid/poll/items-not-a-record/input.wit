package temporal:poll-items-not-a-record@1.0.0;

world service { export reader; }

/// @nexus.endpoint "reader"
interface reader {
  record read-request { offset: option<s64> }

  // `items` names a field of the response, so the response is a record.
  /// @nexus.poll python="next_read" items="items" targets="client"
  read: func(request: read-request) -> string;
}

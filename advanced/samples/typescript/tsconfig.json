{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "esnext.temporal"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true
  },
  "include": ["wit/**/*.ts", "json_schema/**/*.ts", "tests/**/*.ts"]
}

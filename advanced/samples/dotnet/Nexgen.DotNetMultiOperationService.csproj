<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Nexgen.DotNetMultiOperationService</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The generated interceptor partial requires matching SDK changes. -->
    <Compile Include="wit/multi-operation-service/**/*.cs"
             Exclude="wit/multi-operation-service/SystemNexusWorkflowOutboundInterceptor.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.26.1" />
    <PackageReference Include="NexusRpc" Version="0.4.0" />
    <PackageReference Include="Temporalio" Version="1.20.0" />
  </ItemGroup>
</Project>

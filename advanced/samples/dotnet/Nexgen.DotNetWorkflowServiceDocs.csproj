<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);1591</WarningsAsErrors>
    <AssemblyName>Nexgen.DotNetWorkflowServiceDocs</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin/**/*.cs;obj/**/*.cs;tests/**/*.cs;*.cs;wit/**/*.cs;TemporalSupport/**/*.cs" />
    <!-- The generated interceptor partials require matching SDK changes. -->
    <Compile Include="wit/workflow-service/**/*.cs"
             Exclude="wit/workflow-service/SystemNexusWorkflowOutboundInterceptor.cs;wit/workflow-service/Support/*.cs" />
    <Compile Include="TemporalSupport/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.26.1" />
    <PackageReference Include="NexusRpc" Version="0.4.0" />
    <PackageReference Include="Temporalio" Version="1.20.0" />
  </ItemGroup>
</Project>

package temporal:nexus@1.0.0;

world system {
  export interceptor-service;
}

/// @nexus.endpoint "__temporal_system"
interface interceptor-service {
  use nexus:temporal-types/model@1.0.0.{placeholder};

  /// @nexus.type-parameter
  type value-t = placeholder;

  record request {
    id: string,
  }

  record response {
    value: string,
  }

  // The records are generic, so the interceptor handles every type argument of the operation.
  record value-request {
    id: string,
    value: value-t,
  }

  record value-response {
    values: list<value-t>,
  }

  /// @nexus.operation name="FirstOperation"
  first-operation: func(request: request) -> response;

  /// @nexus.operation name="SecondOperation"
  second-operation: func(request: request) -> response;

  /// @nexus.operation name="ValueOperation"
  value-operation: func(request: value-request) -> value-response;
}

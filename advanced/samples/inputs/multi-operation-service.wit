package temporal:nexus@1.0.0;

world system {
  export interceptor-service;
}

/// @nexus.endpoint "__temporal_system"
interface interceptor-service {
  record request {
    id: string,
  }

  record response {
    value: string,
  }

  /// @nexus.operation name="FirstOperation"
  first-operation: func(request: request) -> response;

  /// @nexus.operation name="SecondOperation"
  second-operation: func(request: request) -> response;
}

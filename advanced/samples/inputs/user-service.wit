package temporal:user-service@1.0.0;

world system {
  export user-service;
}

interface user-service {
  resource user {
    constructor(user-id: string, email: string);

    update-email: func(email: string) -> user-result;
    notify: func(
      reason: option<string>,
      channels: list<string>,
      sender: string,
      attempt: option<s64>,
    );
  }

  type user-result = own<user>;

  record get-user-request {
    user-id: string,
  }

  record update-email-request {
    user-id: string,
    email: string,
  }

  record notify-request {
    user-id: string,
    reason: option<string>,
    channels: list<string>,
    sender: string,
    // A plain record holds a 64-bit integer as a number, so the resource method takes a number.
    attempt: option<s64>,
    // The user's own email has the same name and another type, so it must not fill this field.
    email: option<bool>,
  }

  // The client flattens both records. One has a required field, and the other has only optional
  // fields, so its parameters can leave it unset.
  /// @nexus.flatten-in-api
  record address {
    city: string,
    postal-code: option<string>,
  }

  /// @nexus.flatten-in-api
  record contact-preferences {
    locale: option<string>,
    timezone: option<string>,
  }

  record update-profile-request {
    user-id: string,
    address: address,
    preferences: option<contact-preferences>,
  }

  // No field, so a caller method takes no parameter.
  record notify-all-request {
  }

  get-user: func(request: get-user-request) -> user-result;
  update-email: func(request: update-email-request) -> user-result;
  notify: func(request: notify-request);
  update-profile: func(request: update-profile-request);
  notify-all: func(request: notify-all-request);
}

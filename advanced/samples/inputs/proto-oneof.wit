/// Protobuf-oneof generation and runtime fixture.
package temporal:nexus@1.0.0;

world system {
  export proto-oneof;
}

interface proto-oneof {
  use nexus:temporal-types/model@1.0.0.{
    failure,
    payloads,
    placeholder,
  };

  /// Generic logical value carried by protobuf `Payloads` on the wire.
  /// @nexus.type-parameter
  type output-t = placeholder;

  /// @nexus.proto "temporal.api.update.v1.Outcome.value"
  variant outcome-value {
    success(output-t),
    failure(failure),
  }

  /// @nexus.proto "temporal.api.update.v1.Outcome"
  record outcome {
    value: outcome-value,
  }

  /// Selects an activity by ID or activity type.
  /// @nexus.proto "temporal.api.workflowservice.v1.PauseActivityRequest.activity"
  variant activity-selection {
    id(string),
    %type(string),
  }

  /// @nexus.proto "temporal.api.common.v1.WorkflowExecution"
  record workflow-execution {
    workflow-id: string,
    run-id: string,
  }

  /// @nexus.proto "temporal.api.nexus.v1.EndpointTarget.Worker"
  record worker {
    namespace: string,
    task-queue: string,
  }

  /// @nexus.proto "temporal.api.nexus.v1.EndpointTarget.External"
  record endpoint-external-target {
    url: string,
  }

  // Each case names a proto-bound record, and one case has its record's name.
  /// @nexus.proto "temporal.api.nexus.v1.EndpointTarget.variant"
  variant endpoint-target-variant {
    worker(worker),
    external(endpoint-external-target),
  }

  /// @nexus.proto "temporal.api.nexus.v1.EndpointTarget"
  record endpoint-target {
    %variant: option<endpoint-target-variant>,
  }

  /// @nexus.proto "temporal.api.workflowservice.v1.PauseActivityRequest"
  record pause-activity-request {
    namespace: string,
    execution: option<workflow-execution>,
    identity: string,
    activity: option<activity-selection>,
    reason: string,
    request-id: string,
  }
}

package temporal:type-showcase@1.0.0;

world system {
  export type-showcase;
}

/// @nexus.endpoint "type-showcase"
/// @nexus.experimental
interface type-showcase {
  enum user-status {
    active,
    suspended,
    deleted,
  }

  flags user-capability {
    read-profile,
    update-email,
    deactivate,
  }

  /// @nexus.doc "Default notification target." python="Python notification target." typescript="TypeScript notification target." go="Go notification target." dotnet="Dotnet variant <doc> & more."
  /// @nexus.experimental
  variant notification-target {
    /// @nexus.doc "Default payload." python="Python payload." typescript="TypeScript payload */ safe." go="Go payload." dotnet="Dotnet payload <doc> & more."
    email(string),
    /// @nexus.doc "XML characters remain valid in docs: <tag attr=\"value\"> & 'quoted'."
    sms(string),
    /// @nexus.doc "Default empty case."
    none,
    /// @nexus.doc typescript="TypeScript-only case."
    undocumented,
  }

  /// @nexus.doc "Default-only documentation on a single-case variant."
  variant single-target {
    /// @nexus.doc "Only case."
    only,
  }

  /// @nexus.experimental
  variant experimental-target {
    second,
  }

  record postal-address {
    /// @nexus.doc "Street with <tag> & \"quotes\"." dotnet="Street with <tag> & \"quotes\"."
    street: string,
    city: string,
    country: string,
    coordinates: option<tuple<f64, f64>>,
  }

  record user-profile {
    /// @nexus.doc "A very long field doc that has to be wrapped because it exceeds the generated comment line width by a comfortable margin for testing."
    tags: list<string>,
    /// @nexus.doc "Default metadata." go="Go-specific metadata." python="Python metadata."
    metadata: map<string, string>,
    capabilities: user-capability,
    sync-state: result<string, string>,
    notification-target: notification-target,
    address: option<postal-address>,
    single-target: option<single-target>,
    experimental-target: option<experimental-target>,
  }

  /// @nexus.doc "Default user." go="Go user." python="Python user."
  resource user {
    constructor(user-id: string, email: string, display-name: string, status: user-status, profile: user-profile);

    update-email: func(email: string) -> user-result;
    /// @nexus.doc "Default rename." go="Go rename." python="Python rename."
    rename: func(display-name: string) -> user-result;
    deactivate: func(reason: option<string>);
  }

  /// @nexus.experimental
  record get-user-request {
    user-id: string,
    consistency-token: option<string>,
  }

  type user-result = own<user>;

  record update-email-request {
    user-id: string,
    email: string,
  }

  record rename-request {
    user-id: string,
    display-name: string,
  }

  record set-profile-request {
    user-id: string,
    profile: user-profile,
  }

  /// @nexus.experimental
  record sync-report {
    route: list<tuple<f64, f64>>,
    attempts: list<result<string, string>>,
    region-status: map<string, result<string, string>>,
    item-count: u32,
    byte-count: u64,
    clock-skew-ms: s64,
  }

  record record-sync-request {
    user-id: string,
    report: sync-report,
  }

  record deactivate-request {
    user-id: string,
    reason: option<string>,
  }

  /// @nexus.doc "Get a user." returns="The matching user."
  /// @nexus.experimental
  get-user: func(request: get-user-request) -> user-result;
  update-email: func(request: update-email-request) -> user-result;
  rename: func(request: rename-request) -> user-result;
  set-profile: func(request: set-profile-request) -> user-result;
  record-sync: func(request: record-sync-request);
  deactivate: func(request: deactivate-request);
}

package temporal:nexus@1.0.0;

world system {
  export proto-enums;
}

interface proto-enums {
  use nexus:temporal-types/model@1.0.0.{placeholder};

  /// Normal case: declaration order agrees with protobuf numbering.
  /// @nexus.proto "temporal.api.enums.v1.NamespaceState"
  enum namespace-state {
    namespace-state-unspecified,
    namespace-state-registered,
    namespace-state-deprecated,
    namespace-state-deleted,
  }

  /// Reordered case: low is 3 on the wire, not 0.
  /// @nexus.proto "temporal.api.enums.v1.Severity"
  enum alert-level {
    severity-low,
    severity-high,
    severity-medium,
    severity-unspecified,
  }

  /// Sparse case: protobuf reserves 15, so modify-workflow-properties is 16.
  /// @nexus.proto "temporal.api.enums.v1.CommandType"
  enum command-type {
    command-type-unspecified,
    command-type-schedule-activity-task,
    command-type-request-cancel-activity-task,
    command-type-start-timer,
    command-type-complete-workflow-execution,
    command-type-fail-workflow-execution,
    command-type-cancel-timer,
    command-type-cancel-workflow-execution,
    command-type-request-cancel-external-workflow-execution,
    command-type-record-marker,
    command-type-continue-as-new-workflow-execution,
    command-type-start-child-workflow-execution,
    command-type-signal-external-workflow-execution,
    command-type-upsert-workflow-search-attributes,
    command-type-protocol-message,
    command-type-modify-workflow-properties,
    command-type-schedule-nexus-operation,
    command-type-request-cancel-nexus-operation,
  }

  /// @nexus.proto "temporal.api.namespace.v1.NamespaceInfo"
  record namespace-info {
    /// @nexus.default "namespace-state-registered"
    state: namespace-state,
    /// @nexus.omit
    name: placeholder,
    /// @nexus.omit
    description: placeholder,
    /// @nexus.omit
    owner-email: placeholder,
    /// @nexus.omit
    data: placeholder,
    /// @nexus.omit
    id: placeholder,
    /// @nexus.omit
    capabilities: placeholder,
    /// @nexus.omit
    limits: placeholder,
    /// @nexus.omit
    supports-schedules: placeholder,
  }

  /// @nexus.proto "temporal.api.version.v1.Alert"
  record alert {
    message: string,
    /// @nexus.default "severity-low"
    severity: alert-level,
  }

  /// @nexus.proto "temporal.api.command.v1.Command"
  record command-model {
    /// @nexus.default "command-type-modify-workflow-properties"
    command-type: command-type,
    /// @nexus.omit
    user-metadata: placeholder,
    /// @nexus.omit
    event-group-markers: placeholder,
    /// @nexus.omit
    attributes: placeholder,
  }
}

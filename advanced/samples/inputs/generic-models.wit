package temporal:nexus@1.0.0;

world system {
  export generic-model-service;
}

/// @nexus.endpoint "generic-models"
interface generic-model-service {
  use nexus:temporal-types/model@1.0.0.{placeholder};

  /// @nexus.type-parameter
  type context-t = placeholder;

  /// @nexus.type-parameter
  type output-t = placeholder;

  /// @nexus.type-parameter
  type metadata-t = placeholder;

  record inner {
    value: context-t,
  }

  record generic-request {
    context: context-t,
    contexts: list<context-t>,
    by-name: map<string, context-t>,
    nested: inner,
  }

  variant operation-completion-result {
    success(output-t),
    failure(string),
  }

  record generic-response {
    context: context-t,
    completion: operation-completion-result,
    metadata: option<metadata-t>,
  }

  record reuse-completion-result {
    %result: operation-completion-result,
  }

  complete: func(request: generic-request) -> generic-response;
  reuse-complete: func(request: generic-request) -> reuse-completion-result;
}

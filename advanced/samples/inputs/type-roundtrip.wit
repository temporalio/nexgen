package temporal:nexus@1.0.0;

world system {
  export type-roundtrip-service;
}

/// @nexus.endpoint "temporal-system"
interface type-roundtrip-service {
  use nexus:temporal-types/model@1.0.0.{
    duration,
    failure,
    placeholder,
    priority,
    retry-policy,
    task-queue,
  };

  /// @nexus.proto "temporal.api.activity.v1.ActivityOptions" typescript-import="@temporalio/proto"
  record activity-options {
    task-queue: option<task-queue>,
    retry-policy: retry-policy,
    schedule-to-close-timeout: option<duration>,
    priority: option<priority>,
    /// @nexus.omit
    schedule-to-start-timeout: placeholder,
    /// @nexus.omit
    start-to-close-timeout: placeholder,
    /// @nexus.omit
    heartbeat-timeout: placeholder,
    /// @nexus.omit
    start-delay: placeholder,
  }

  /// @nexus.proto "temporal.api.command.v1.FailWorkflowExecutionCommandAttributes" typescript-import="@temporalio/proto"
  record failure-container {
    failure: option<failure>,
  }

  activity-options-operation: func(request: activity-options) -> activity-options;
  failure-operation: func(request: failure-container) -> failure-container;
}

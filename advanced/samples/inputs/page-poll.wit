package example:page-poll@1.0.0;

world service {
  export catalog;
}

/// @nexus.endpoint "catalog"
interface catalog {
  record page-request {
    cursor: u32,
  }

  record page {
    values: list<string>,
    next: option<page-request>,
  }

  /// @nexus.poll python="next_page_request"
  list-pages: func(request: page-request) -> page;

  /// @nexus.poll python="next_page_request" items="values"
  list-items: func(request: page-request) -> page;
}

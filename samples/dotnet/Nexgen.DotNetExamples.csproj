<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Nexgen.DotNetExamples</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Beginner-facing JSON-Schema definitions-mode samples. -->
    <Compile Remove="bin/**/*.cs;obj/**/*.cs;tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NexusRpc" Version="0.4.0" />
    <PackageReference Include="Temporalio" Version="1.19.0" />
  </ItemGroup>
</Project>
